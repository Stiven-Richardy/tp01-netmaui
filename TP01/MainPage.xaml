<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TP01.MainPage"
             BackgroundColor="Black">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="Aplicação Teste"
               TextColor="White"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,30" />

        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="15" ColumnSpacing="10">

            <Label Grid.Row="0" Grid.Column="0" 
                   Text="ID:" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" />

            <Entry x:Name="IdEntry" 
                   Grid.Row="0" Grid.Column="1" 
                   BackgroundColor="White" 
                   TextColor="Black" />

            <Label Grid.Row="1" Grid.Column="0" 
                   Text="Pass:" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" />

            <Entry x:Name="PassEntry" 
                   Grid.Row="1" Grid.Column="1" 
                   BackgroundColor="White" 
                   TextColor="Black" 
                   IsPassword="True" />
        </Grid>

        <VerticalStackLayout Spacing="15" Margin="0,40,0,0">
            <Button Text="OK" 
                    BackgroundColor="LightGray" 
                    TextColor="Maroon" 
                    FontAttributes="Bold"
                    Clicked="OnOkClicked" />

            <Button Text="Limpar" 
                    BackgroundColor="LightGray" 
                    TextColor="Maroon" 
                    FontAttributes="Bold"
                    Clicked="OnLimparClicked" />

            <Button Text="Créditos" 
                    BackgroundColor="LightGray" 
                    TextColor="Maroon" 
                    FontAttributes="Bold"
                    Clicked="OnCreditosClicked" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>